# ==============================================================================
# MAADT Docker Configuration
# ==============================================================================

# Ollama LLM Gateway URL
# Use "http://host.docker.internal:11434" when Ollama is running on your host machine.
# Use "http://ollama:11434" if running Ollama as a Docker container via:
#   docker compose --profile ollama up
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Frontend Client Public Endpoints (Accessible from Browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry

# Backend Internal Configuration
MAADT_CONFIG_DIR=/app/configs
MAADT_DB_PATH=/app/data/maadt_data.db
