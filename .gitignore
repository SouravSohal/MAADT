# ----------------------------------------------------------
# Environment Variables & Sensitive Credentials
# ----------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Secrets, Certificates & Cloud Service Account Keys
*.pem
*.key
*.crt
*service-account*.json
*credentials*.json
*client_secret*.json
gcp-key.json
sa-key.json

# ----------------------------------------------------------
# Python Bytecode, Compilations & Builds
# ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Virtual Environments
.venv/
venv/
ENV/
env/
**/venv/
**/.venv/

# Testing, Linters & Static Analysis
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.hypothesis/

# ----------------------------------------------------------
# SQLite Databases, State Stores & Data Volumes
# ----------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.log
maadt_data.db
**/maadt_data.db
data/
**/data/
*.pid

# ----------------------------------------------------------
# Node.js, Next.js & Frontend Builds
# ----------------------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.turbo/
**/.turbo/
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
*.tsbuildinfo

# ----------------------------------------------------------
# Desktop / Electron Packaging Artifacts
